{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist-server",
        "rootDir": ".",
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["server/**/*.ts", "src/rclone/queue-types.ts"]
}
